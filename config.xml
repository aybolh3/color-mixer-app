<?xml version='1.0' encoding='utf-8'?>
<widget id="com.aybolh3.colormixer" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>ColorMixer</name>
    <description>ColorMixer Application</description>
    <author email="dev@example.com" href="https://example.com">
        Rachid
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <platform name="android">
        <allow-intent href="market:*" />
        
        <!-- إعداد الأيقونة الأساسية لتفادي أخطاء AAPT -->
        <icon src="www/icon.png" />
        
        <!-- إعدادات البناء الخاصة بـ Android -->
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="36" />
    </platform>

    <preference name="Fullscreen" value="false" />
    <preference name="Orientation" value="default" />
</widget>
