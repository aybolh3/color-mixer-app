<?xml version='1.0' encoding='utf-8'?>
<widget id="com.aybolh3.colormixer" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>ColorMixer</name>
    <description>Color Mixer Application</description>
    <author email="dev@example.com" href="https://example.com">Developer</author>
    
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- أيقونات Android -->
    <platform name="android">
        <icon density="mdpi" src="android/mipmap-mdpi/ic_launcher.png" />
        <icon density="hdpi" src="android/mipmap-hdpi/ic_launcher.png" />
        <icon density="xhdpi" src="android/mipmap-xhdpi/ic_launcher.png" />
        <icon density="xxhdpi" src="android/mipmap-xxhdpi/ic_launcher.png" />
    </platform>

    <!-- أيقونات iOS -->
    <platform name="ios">
        <icon src="Assets.xcassets/AppIcon.appiconset/20.png" width="20" height="20" />
        <icon src="Assets.xcassets/AppIcon.appiconset/29.png" width="29" height="29" />
        <icon src="Assets.xcassets/AppIcon.appiconset/40.png" width="40" height="40" />
