<?xml version='1.0' encoding='utf-8'?>
<widget id="com.aybolh3.colormixer" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>ColorMix Studio</name>
    <description>تطبيق استوديو خلط الألوان </description>
    <author email="dev@colormixer.com" href="https://github.com/aybolh3">ayb</author>
    
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <platform name="android">
        <allow-intent href="market:*" />
        <preference name="Scheme" value="https" />
        <preference name="AndroidWindowSplashScreenBackground" value="#FFFFFF" />
    </platform>
</widget>
