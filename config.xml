<?xml version='1.0' encoding='utf-8'?>
<widget id="com.aybolh3.colormixer" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    
    <!-- معلومات التطبيق -->
    <name>ColorMixer</name>
    <description>تطبيق استوديو خلط الألوان ومعيار الأغطية</description>
    <author email="dev@example.com" href="https://github.com/aybolh3">ayb</author>
    
    <!-- الصفحة الرئيسية -->
    <content src="index.html" />
    
    <!-- الصلاحيات -->
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />

    <!-- إعدادات الأندرويد والأيقونات من الجذر مباشرة -->
    <platform name="android">
        <allow-intent href="market:*" />
        
        <preference name="AndroidPersistentFileLocation" value="Compatibility" />
        <preference name="KeepRunning" value="true" />
        
        <!-- الأيقونات الخارجية لشاشة الهاتف -->
        <icon density="hdpi" src="mipmap-hdpi/ic_launcher.png" />
        <icon density="mdpi" src="mipmap-mdpi/ic_launcher.png" />
        <icon density="xhdpi" src="mipmap-xhdpi/ic_launcher.png" />
        <icon density="xxhdpi" src="mipmap-xxhdpi/ic_launcher.png" />
        <icon density="xxxhdpi" src="mipmap-xxxhdpi/ic_launcher.png" />
    </platform>

    <!-- إعدادات الشاشة -->
    <preference name="ScrollEnabled" value="false" />
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />

</widget>
