
<?xml version='1.0' encoding='utf-8'?>
<widget id="com.aybolh3.colormixer" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>ColorMix Studio</name>
    <description>تطبيق استوديو خلط الألوان ومطابقة الصبغات بالغطاء والمعايير الدقيقة.</description>
    <author email="dev@colormixer.com" href="https://github.com/aybolh3">Rachid</author>
    
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    
    <!-- ربط الأيقونة الخارجية للتطبيق -->
    <icon src="icon.png" />

    <platform name="android">
        <allow-intent href="market:*" />
        <icon src="icon.png" density="ldpi" />
        <icon src="icon.png" density="mdpi" />
        <icon src="icon.png" density="hdpi" />
        <icon src="icon.png" density="xhdpi" />
        <icon src="icon.png" density="xxhdpi" />
        <icon src="icon.png" density="xxxhdpi" />
    </platform>
</widget>
