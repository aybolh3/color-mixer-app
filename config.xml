<platform name="android">
        <allow-intent href="market:*" />

        <!-- 1. الأيقونة الرئيسية الاحتياطية (Default / Fallback Icon) -->
        <icon src="mipmap-xhdpi/ic_launcher.png" />

        <!-- 2. أيقونات Mipmap للشاشات المختلفة (Legacy Icons) -->
        <icon src="mipmap-mdpi/ic_launcher.png" density="mdpi" />
        <icon src="mipmap-hdpi/ic_launcher.png" density="hdpi" />
        <icon src="mipmap-xhdpi/ic_launcher.png" density="xhdpi" />
        <icon src="mipmap-xxhdpi/ic_launcher.png" density="xxhdpi" />
        <icon src="mipmap-xxxhdpi/ic_launcher.png" density="xxxhdpi" />

        <!-- 3. الأيقونة الذكية للهواتف الحديثة (Adaptive Icon) -->
        <icon density="ldpi" foreground="mipmap-mdpi/ic_launcher.png" background="#FFFFFF" />
        <icon density="mdpi" foreground="mipmap-mdpi/ic_launcher.png" background="#FFFFFF" />
        <icon density="hdpi" foreground="mipmap-hdpi/ic_launcher.png" background="#FFFFFF" />
        <icon density="xhdpi" foreground="mipmap-xhdpi/ic_launcher.png" background="#FFFFFF" />
        <icon density="xxhdpi" foreground="mipmap-xxhdpi/ic_launcher.png" background="#FFFFFF" />
        <icon density="xxxhdpi" foreground="mipmap-xxxhdpi/ic_launcher.png" background="#FFFFFF" />

        <!-- 4. إعدادات إصدارات الأندرويد -->
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="34" />
    </platform>
